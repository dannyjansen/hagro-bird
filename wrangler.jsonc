{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hagro-bird",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hagro-bird",
      "database_id": "2b836d4a-74df-410d-8fb9-b40f8df2c309",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@dannojustin.com"]
    }
  ],
  "vars": {
    "EMAIL_FROM": "HagroBird <hello@dannojustin.com>",
    "TRUSTED_ORIGINS": "https://hagro-bird.vercel.app"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
