{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hagro-bird",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hagro-bird",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "EMAIL_FROM": "HagroBird <beth.t@example.com>"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
